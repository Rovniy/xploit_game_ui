# Native build outputs
native/out/
native/vcpkg_installed/
build/
*.user
*.suo
.vs/
.cache/
CMakeUserPresets.json

# V8 NuGet packages are fetched at build time
native/third_party/v8/

# Unity Native Plugin API headers are copied from a local Unity install by
# tools/fetch-unity-headers.ps1; they belong to Unity and are not redistributed
# here (see docs/THIRD-PARTY-NOTICES.md).
native/third_party/unity/

# Unity
