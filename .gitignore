unity/Sandbox/[Bb]uilds/
unity/Sandbox/[Ll]ogs/
unity/Sandbox/[Uu]ser[Ss]ettings/
unity/Sandbox/*.csproj
unity/Sandbox/*.sln
unity/Sandbox/.vsconfig
unity/Packages/com.xploit.game_ui/Plugins/x86_64/*.dll
unity/Packages/com.xploit.game_ui/Plugins/x86_64/*.pdb
unity/Packages/com.xploit.game_ui/Plugins/x86_64/*.dat
unity/Packages/com.xploit.game_ui/Plugins/x86_64/*.bin
!unity/Packages/com.xploit.game_ui/Plugins/x86_64/*.meta

# Test artifacts
native/tests/testdata/golden/*_actual.png
