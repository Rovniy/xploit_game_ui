root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,hpp,cpp,cc,c}]
indent_size = 4

[*.{cs}]
indent_size = 4
end_of_line = crlf

[*.{cmake,txt,json,yml,yaml,md,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
